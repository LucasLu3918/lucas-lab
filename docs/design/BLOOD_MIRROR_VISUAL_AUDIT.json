  "findings": [
    {
      "id": "UI-001",
      "component": "Navigation",
      "route": "/games/blood-mirror/play/",
      "symptom": "Mobile navigation had no accessible opener",
      "classification": "outlier",
      "valid_variant": false,
      "approved_exception": false,
      "root_cause": {
        "source": "games/blood-mirror/style.css",
        "style": "nav @850",
        "mechanism": "display:none without menu control"
      },
      "fix": "Responsive menu with aria-expanded, inert and Escape",
      "status": "closed"
    },
    {
      "id": "UI-002",
      "component": "Objective",
      "route": "/games/blood-mirror/play/",
      "symptom": "Objective followed scene on mobile",
      "classification": "outlier",
      "valid_variant": false,
      "approved_exception": false,
      "root_cause": {
        "source": "games/blood-mirror/index.html",
        "style": ".objective-block",
        "mechanism": "Objective existed in sidebar after scene"
      },
      "fix": "Move objective and true progress above scene",
      "status": "closed"
    },
    {
      "id": "UI-003",
      "component": "Dialog",
      "route": "/games/blood-mirror/play/",
      "symptom": "Closing control scrolls away in long dialog",
      "classification": "outlier",
      "valid_variant": false,
      "approved_exception": false,
      "root_cause": {
        "source": "games/blood-mirror/style.css",
        "style": ".modal-shell",
        "mechanism": "Entire modal shell scrolled"
      },
      "fix": "Fixed header with independently scrollable body",
      "status": "closed"
    },
    {
      "id": "UI-004",
      "component": "Typography",
      "route": "/games/blood-mirror/play/",
      "symptom": "Small low contrast text",
      "classification": "outlier",
      "valid_variant": false,
      "approved_exception": false,
      "root_cause": {
        "source": "games/blood-mirror/style.css",
        "style": ".narrative-block p",
        "mechanism": "Several 9–12px body/status values"
      },
      "fix": "Larger text, consistent muted color and saved large-text preference",
      "status": "closed"
    },
    {
      "id": "UI-005",
      "component": "Home action",
      "route": "/games/blood-mirror/play/",
      "symptom": "New journey was primary despite existing progress",
      "classification": "outlier",
      "valid_variant": false,
      "approved_exception": false,
      "root_cause": {
        "source": "games/blood-mirror/app.js",
        "style": "renderHome",
        "mechanism": "Primary class hard-coded to start button"
      },
      "fix": "Continue journey primary when save exists",
      "status": "closed"
    },
    {
      "id": "UI-006",
      "component": "Puzzle selection",
      "route": "/games/blood-mirror/play/",
      "symptom": "Selection changes border geometry",
      "classification": "outlier",
      "valid_variant": false,
      "approved_exception": false,
      "root_cause": {
        "source": "games/blood-mirror/challenges.css",
        "style": ".picture-tile.selected",
        "mechanism": "Selected border 3px versus default 2px"
      },
      "fix": "Retain 2px border; use color and shadow",
      "status": "closed"
    },
    {
      "id": "UI-007",
      "component": "Gallery",
      "route": "/games/blood-mirror/play/",
      "symptom": "Portrait crops conceal the full artwork",
      "classification": "outlier",
      "valid_variant": false,
      "approved_exception": false,
      "root_cause": {
        "source": "games/blood-mirror/gallery.css",
        "style": ".artwork-card img",
        "mechanism": "object-fit:cover on 4/3 cards"
      },
      "fix": "Use contain with dark letterboxing",
      "status": "closed"
    },
    {
      "id": "UI-008",
      "component": "Favicon",
      "route": "/games/blood-mirror/play/",
      "symptom": "Main site lacked favicon",
      "classification": "outlier",
      "valid_variant": false,
      "approved_exception": false,
      "root_cause": {
        "source": "scripts/build.cjs",
        "style": "page head",
        "mechanism": "No rel=icon in generated head"
      },
      "fix": "Local compass SVG on site; crowned mirror SVG on game",
      "status": "closed"
    }
  ],
